# Copy to .env and fill in. .env is ignored by git and never committed.
GOOGLE_API_KEY=your-gemini-api-key
# Optional overrides
GEMINI_MODEL=gemini-3.8-flash
BATCHGUARD_DATA=~/Projects/batchguard_data
BATCHGUARD_LLM=gemini
# Optional: human review in Power Automate (docs/power_automate.md)
POWER_AUTOMATE_FLOW_URL=https://prod-00.westus.logic.azure.com/workflows/...
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
APPROVAL_TOKEN=a-long-random-string
